{
  "name": "refuse",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable OSS edition of refuse — gate AI coding agents from installing vulnerable packages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/RefuseHQ/refuse.git"
  },
  "homepage": "https://github.com/RefuseHQ/refuse",
  "bugs": {
    "url": "https://github.com/RefuseHQ/refuse/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "dev": "pnpm --filter @refuse-oss/server dev"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "vite": "^8.0.16"
  }
}
